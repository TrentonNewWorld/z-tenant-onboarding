# z-tenant-onboarding — copy to .env and fill in. Never commit .env.
#
# Four separate identities. They are NOT interchangeable, and reusing one for
# another is the most common cause of a confusing failure.

# TENANT — owns the contract and its KV maps. Used by client/setup.ts only.
# Issued once by the ADK claim page (https://terminal3.io/products/agent-developer-kit),
# shown a single time and unrecoverable afterwards. Google sign-in only; there
# is no API or CLI path to mint one.
T3N_API_KEY=

# AGENT — invokes the contract. Used by client/run-check.ts.
# A SEPARATE credential from the tenant key, obtained the same way. Its DID has
# its own credit balance starting at zero: an unfunded agent key fails metered
# calls with InsufficientCreditError even though the tenant has credits.
AGENT_KEY=

# USER — the data owner. Signs the agent-auth grant, and is the profile the
# host resolves {{profile.*}} markers from. In production this is a real end
# user's key; for a local end-to-end run you stand in for them.
USER_KEY=

# Tenant DID, printed by client/setup.ts ("authenticated as did:t3n:...").
# Copy it from that output — it is platform-assigned and cannot be derived
# from an address.
TENANT_DID=

# PROVIDER — the screening vendor's token. setup.ts seeds this into
# z:<tid>:secrets over the control plane; it is never held by this repo at
# runtime and never enters WASM memory in plaintext.
ONBOARDING_API_KEY=

# The screening provider's hostname, with no scheme and no path. This exact
# string goes into the user's grant as the contract's only allowed egress
# host; anything else is denied with host/http.egress_denied.
SCREENING_HOST=api.example-screening.com

# Optional — override if you build somewhere other than the default target dir.
# WASM_PATH=target/wasm32-wasip2/release/z_tenant_onboarding.wasm
